<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_limit_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_limit_app_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_burst_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_burst_size"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_min_wait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_min_wait"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_max_wait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_max_wait"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_limit_system_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_limit_system_desc"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_system_permission_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CC6600"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_system_max_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_system_max_count"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_system_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_system_interval_minutes"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/button_system_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
